{
  "name": "install-package-skills",
  "version": "0.9.3",
  "description": "Installs the agent skills of the packages a repository lists in devSkills into .claude/skills and .agents/skills. Plain Node, no dependencies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gergelyszerovay/install-package-skills.git",
    "directory": "packages/package-skills"
  },
  "type": "module",
  "license": "MIT",
  "releaseTools": {
    "npmName": "install-package-skills"
  },
  "author": "Gergely Szerovay",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "install-package-skills": "bin/package-skills.mjs",
    "package-skills": "bin/package-skills.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/package-skills.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publint": "publint --strict"
  },
  "files": [
    "bin",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "publint": "^0.3.24"
  },
  "changelog": {
    "group": "package-skills"
  }
}
